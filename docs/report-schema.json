          "type": "string"
        },
        "baseline_cell_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Cell Type"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source_diff": {
          "items": {
            "type": "string"
          },
          "title": "Source Diff",
          "type": "array"
        },
        "source_diff_truncated": {
          "default": false,
          "title": "Source Diff Truncated",
          "type": "boolean"
        },
        "baseline_execution_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Execution Count"
        },
        "candidate_execution_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Execution Count"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/OutputChange"
          },
          "title": "Outputs",
          "type": "array"
        },
        "metadata_changes": {
          "items": {
            "type": "string"
          },
          "title": "Metadata Changes",
          "type": "array"
        }
      },
      "required": [
        "status",
        "match",
        "cell_type",
        "title"
      ],
      "title": "CellChange",
      "type": "object"
    },
