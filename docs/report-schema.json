{
  "$defs": {
    "ArrayComparison": {
      "additionalProperties": false,
      "properties": {
        "baseline_shape": {
          "items": {
            "type": "integer"
          },
          "title": "Baseline Shape",
          "type": "array"
        },
        "candidate_shape": {
          "items": {
            "type": "integer"
          },
          "title": "Candidate Shape",
          "type": "array"
        },
        "comparable": {
          "title": "Comparable",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "size": {
          "default": 0,
          "title": "Size",
          "type": "integer"
        },
        "changed_elements": {
          "default": 0,
          "title": "Changed Elements",
          "type": "integer"
        },
        "exceeding_elements": {
          "default": 0,
          "title": "Exceeding Elements",
          "type": "integer"
        },
        "nan_mismatches": {
          "default": 0,
          "title": "Nan Mismatches",
          "type": "integer"
        },
        "inf_mismatches": {
          "default": 0,
          "title": "Inf Mismatches",
          "type": "integer"
        },
        "max_abs_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Abs Difference"
        },
        "max_abs_difference_index": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Abs Difference Index"
        },
        "baseline_at_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "nan",
                "inf",
                "-inf"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline At Max"
        },
        "candidate_at_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "nan",
                "inf",
                "-inf"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate At Max"
        },
        "mean_abs_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Abs Difference"
        },
        "rms_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rms Difference"
        },
        "relative_l2_error": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "||candidate - baseline||2 / ||baseline||2.",
          "title": "Relative L2 Error"
        }
      },
      "required": [
        "baseline_shape",
        "candidate_shape",
        "comparable"
      ],
      "title": "ArrayComparison",
      "type": "object"
    },
    "CellChange": {
