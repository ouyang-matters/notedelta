    "ScalarComparison": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "nan",
                "inf",
                "-inf"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline"
        },
        "candidate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "nan",
                "inf",
                "-inf"
